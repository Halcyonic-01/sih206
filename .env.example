# Copy to .env (git-ignored; never commit it). settings.py loads .env automatically; real environment variables win.
# Docker Compose also reads .env for the ${...} values in docker-compose.yml.
# Local demo defaults work with NO .env at all. Tags: [REQUIRED] for any shared / production host, [optional] otherwise.

# ===== Core ================================================================================
# [optional] true = local demo. Set false on any shared host (then DJANGO_SECRET_KEY is mandatory).
DJANGO_DEBUG=true
# [REQUIRED when DJANGO_DEBUG=false] Long random secret. python -c "import secrets; print(secrets.token_urlsafe(50))"
# The placeholder below is rejected when DEBUG is off.
DJANGO_SECRET_KEY=replace-with-a-random-value-before-shared-hosting
# [REQUIRED for a real host name] Comma-separated host names the site answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# [optional] Largest PDF upload in MB.
MAX_UPLOAD_MB=10
# [optional] Business timezone for dates and deadlines (not a validated regulatory setting).
BUSINESS_TIMEZONE=Asia/Kolkata
REMINDER_DAYS=30,15,7

# ===== HTTPS and cookies [REQUIRED once the site is reachable over HTTPS] ====================
# Send session and CSRF cookies only over HTTPS.
DJANGO_SECURE_COOKIES=false
# https origins allowed to post to the API when the public URL differs from the host header,
# for example https://fdr.example.gov.in (comma-separated). Empty is fine on localhost.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Redirect http to https (set true behind TLS).
DJANGO_SECURE_SSL_REDIRECT=false
# 0 disables HSTS. Use 31536000 once HTTPS is permanent.
DJANGO_HSTS_SECONDS=0
# true only behind a proxy that overwrites X-Forwarded-Proto.
DJANGO_BEHIND_TLS_PROXY=false

# ===== Sign-in lockout (django-axes) [optional] ================================================
AXES_ENABLED=true
# Failed sign-ins before the account is locked (PS scenario 8 expects 5).
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
# Number of trusted reverse proxies in front of Django (0 = none). Needed to see real client IPs.
AXES_PROXY_COUNT=0
# Rate limit on the sign-in endpoint per client.
API_LOGIN_THROTTLE=30/min
# Two-factor sign-in for staff (authenticator app). true = compulsory for officer, authority, clearance and auditor.
MFA_REQUIRED=false
MFA_STEP_UP_SECONDS=600

# ===== API documentation [optional] ============================================================
# /api/docs/ is open when DJANGO_DEBUG=true and needs sign-in otherwise. Uncomment to override (true/false).
#API_DOCS_PUBLIC=false

# ===== Email notifications [optional; REQUIRED only if real emails must leave the system] ========
# Without EMAIL_HOST emails are printed to the Django console and nothing is sent.
# Local catcher such as Mailpit: EMAIL_HOST=localhost EMAIL_PORT=1025 EMAIL_USE_TLS=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
# Force a backend (for example django.core.mail.backends.dummy.EmailBackend). Normally leave empty.
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=Pramaan <no-reply@localhost>
# [REQUIRED when deployed] Public address used for links inside emails.
PORTAL_BASE_URL=http://127.0.0.1:8010
# Send each email right after its event commits; `manage.py send_notifications` retries failures.
NOTIFY_SEND_ON_COMMIT=true

# ===== Audit hash chain [REQUIRED in production] ================================================
# Secret for the audit hash chain (HMAC). Long random value; keep it out of database backups: whoever has it
# can recompute the chain. Changing it makes verify_audit_chain report every event as broken.
# python -c "import secrets; print(secrets.token_hex(32))"   (empty = derived from DJANGO_SECRET_KEY)
AUDIT_CHAIN_KEY=

# ClamAV's clamd. With CLAMAV_HOST set every uploaded PDF is scanned; an infected file is refused. SCAN_REQUIRED=true also
# refuses uploads while the scanner is unreachable and hides documents that were never scanned (run
# `python manage.py scan_documents` once to scan older ones). Off, uploads are stored as "not scanned".
CLAMAV_HOST=
CLAMAV_PORT=3310
SCAN_REQUIRED=false
=======
# ===== Document encryption at rest [REQUIRED in production] =====================================
# Master key for the AES-256-GCM encryption of stored PDFs (portal/storage.py). Without it (local DEBUG only) PDFs are
# stored in plain form. Keep it in a secret store, not next to data/documents; losing it loses the documents.
# python -c "from config.documentkey import generate_key; print(generate_key())"
DOCUMENT_ENCRYPTION_KEY=
# After rotating to a new key, list the previous one(s) here (comma-separated) until `manage.py encrypt_documents` has
# moved every file to the new key.
DOCUMENT_ENCRYPTION_OLD_KEYS=
# Set to false once `manage.py encrypt_documents` has encrypted every existing file: plaintext files are then refused.
DOCUMENT_ALLOW_PLAINTEXT=true

# ===== Malware scan of uploads [optional; recommended in production] =====================
# ===== Docker Compose only [optional] ===========================================================
# Host port for the web container and whether to create synthetic demo accounts on the first start.
PORTAL_PORT=8010
SEED_DEMO=true

# ===== Frontend development only [optional] =====================================================
# Where `npm run dev` proxies /api to (default http://127.0.0.1:8010).
#DJANGO_URL=http://127.0.0.1:8010

# Local OCR: install Tesseract (English data) and Poppler; set absolute paths if not on PATH.
OCR_ENABLED=true
OCR_TESSERACT=
OCR_PDFTOPPM=
# ===== AI assistance: Google Gemini [optional] ==================================================
# Advisory only (document field extraction, release-case summary); the portal works fully with AI off.
# Draft AICTE check: block acceptance of an FDR recorded with no lien marked (off = advisory warning).
FDR_LIEN_CHECK_BLOCKING=false

# Get a free key at https://aistudio.google.com/apikey , paste it below and set AI_ENABLED=true.
# Then run: python manage.py check_ai   (sends only synthetic test data).
# Free-tier requests may be used by Google to improve its products: send synthetic documents only.
AI_ENABLED=false
GEMINI_API_KEY=
# Free-tier models that read PDFs and return structured JSON. AI_FALLBACK_MODEL is tried once if AI_MODEL is busy.
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=gemini-3.6-flash
# Real (non-simulated) bank confirmation emails stay off until this is true. The SMTP settings are in the
# "Email notifications" section above; define each key once, because the last definition in this file wins.
NOTIFICATION_EMAIL_ENABLED=false
# Operator-reviewed bank directory only; never use an institution-submitted contact.
# Example shape: {"ABCD0123456":{"email":"branch@example.invalid","source":"Approved directory version","approved":true}}
BANK_CONTACTS_JSON={}
BANK_CONFIRMATION_SIMULATED=true
BANK_PUBLIC_BASE_URL=http://127.0.0.1:8010

# Supabase PostgreSQL; empty URI keeps local SQLite. Tests/offline scripts remain SQLite.
DATABASE_BACKEND=auto
DATABASE_URL=
DATABASE_SCHEMA=portal_app
DATABASE_SSLMODE=require
DATABASE_SSL_ROOT_CERT=
