# Copy to .env (git-ignored). settings.py loads .env automatically; real environment variables win.
# Local demo defaults work without any of these.

# --- Core ---------------------------------------------------------------------------------
DJANGO_DEBUG=true
# MANDATORY when DJANGO_DEBUG=false. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-random-value-before-shared-hosting
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
MAX_UPLOAD_MB=10
# Demo reporting configuration, not validated regulatory timelines.
BUSINESS_TIMEZONE=Asia/Kolkata
REMINDER_DAYS=30,15,7

# --- HTTPS / cookies (set these for any shared or production host) -------------------------
DJANGO_SECURE_COOKIES=false
# Comma-separated https origins that may post to the API, e.g. https://fdr.example.gov.in
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false
# 0 disables HSTS. Use 31536000 once HTTPS is permanent.
DJANGO_HSTS_SECONDS=0
# true only behind a proxy that overwrites X-Forwarded-Proto.
DJANGO_BEHIND_TLS_PROXY=false

# --- Sign-in lockout (django-axes) -----------------------------------------------------------
AXES_ENABLED=true
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
# Number of trusted reverse proxies in front of Django (0 = none). Needed for correct client IPs.
AXES_PROXY_COUNT=0
API_LOGIN_THROTTLE=30/min

# --- API documentation -------------------------------------------------------------------------
# /api/docs/ is open when DJANGO_DEBUG=true; set true/false to override.
#API_DOCS_PUBLIC=false

# --- Email notifications (K5) ----------------------------------------------------------------------
# Without EMAIL_HOST, emails are printed to the Django console (nothing leaves the machine).
# Local catcher such as Mailpit: EMAIL_HOST=localhost EMAIL_PORT=1025 EMAIL_USE_TLS=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=AICTE Deposit Portal <no-reply@localhost>
# Used for the links inside emails. Set to the public https address when deployed.
PORTAL_BASE_URL=http://127.0.0.1:8010
# Send emails right after each event commits; send_notifications retries failures (run it every few minutes).
NOTIFY_SEND_ON_COMMIT=true
