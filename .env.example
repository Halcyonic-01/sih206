# Copy to ignored .env. Process environment variables take precedence.
# Local demo defaults work without setting these variables.
DATABASE_BACKEND=auto
# Supabase Dashboard -> Connect -> Session pooler -> URI. Keep credentials server-side.
# Empty DATABASE_URL keeps local SQLite. Test commands always use local SQLite.
DATABASE_URL=
DATABASE_SCHEMA=portal_app
DATABASE_SSLMODE=require
# For production hostname/certificate verification, use verify-full and the Supabase CA file.
DATABASE_SSL_ROOT_CERT=
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-value-before-shared-hosting
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_COOKIES=false
MAX_UPLOAD_MB=10
# Demo reporting configuration, not validated regulatory timelines.
BUSINESS_TIMEZONE=Asia/Kolkata
REMINDER_DAYS=30,15,7

# Local OCR: install Tesseract (English data) and Poppler; set absolute paths if not on PATH.
OCR_ENABLED=true
OCR_TESSERACT=
OCR_PDFTOPPM=
# External AI remains opt-in. Keep the key in the process environment, never in Git.
AI_ENABLED=false
ANTHROPIC_API_KEY=
# Email is off by default; the default backend captures messages locally in memory.
NOTIFICATION_EMAIL_ENABLED=false
DJANGO_EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=portal@example.invalid
# Operator-reviewed bank directory only; never use an institution-submitted contact.
# Example shape: {"ABCD0123456":{"email":"branch@example.invalid","source":"Approved directory version","approved":true}}
BANK_CONTACTS_JSON={}
BANK_CONFIRMATION_SIMULATED=true
BANK_PUBLIC_BASE_URL=http://127.0.0.1:8010
