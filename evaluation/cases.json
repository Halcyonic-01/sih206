{
  "version": 1,
  "provenance": "Generated synthetic metadata and locally generated PDF fixtures. No real institutions, applicants, bank records, external datasets or third-party document content.",
  "ground_truth": "Explicit expected labels manually reviewed against the two-rule contract: an FDR-kind row is required; another same-institution bank/reference pair matches after Unicode casefold and surrounding whitespace removal. Labels do not come from run_checks. No regulatory or authenticity labels.",
  "rules": ["FDR_DOCUMENT_REQUIRED", "POSSIBLE_DUPLICATE"],
  "cases": [
    {"id":"missing", "document":"none", "expected":["FDR_DOCUMENT_REQUIRED"]},
    {"id":"fdr", "document":"FDR", "expected":[]},
    {"id":"release-only", "document":"RELEASE_EVIDENCE", "expected":["FDR_DOCUMENT_REQUIRED"]},
    {"id":"exact", "document":"FDR", "other":{}, "expected":["POSSIBLE_DUPLICATE"]},
    {"id":"both", "document":"none", "other":{}, "expected":["FDR_DOCUMENT_REQUIRED","POSSIBLE_DUPLICATE"]},
    {"id":"ascii-lower", "document":"FDR", "bank":"fictional bank", "reference":"fdr-001", "other":{"bank":"FICTIONAL BANK","reference":"FDR-001"}, "expected":["POSSIBLE_DUPLICATE"]},
    {"id":"spaces", "document":"FDR", "other":{"bank":"  Fictional Bank  ","reference":" FDR-001 "}, "expected":["POSSIBLE_DUPLICATE"]},
    {"id":"bank-different", "document":"FDR", "other":{"bank":"Other Fictional Bank"}, "expected":[]},
    {"id":"reference-different", "document":"FDR", "other":{"reference":"FDR-002"}, "expected":[]},
    {"id":"institution-different", "document":"FDR", "other":{"institution":"other"}, "expected":[]},
    {"id":"self-only", "document":"FDR", "expected":[]},
    {"id":"unicode-uppercase-other", "document":"FDR", "bank":"café bank", "other":{"bank":"CAFÉ BANK"}, "expected":["POSSIBLE_DUPLICATE"]},
    {"id":"unicode-lowercase-other", "document":"FDR", "bank":"CAFÉ BANK", "other":{"bank":"café bank"}, "expected":["POSSIBLE_DUPLICATE"]},
    {"id":"tab-trim", "document":"FDR", "other":{"bank":"\tFictional Bank\t","reference":"\tFDR-001\t"}, "expected":["POSSIBLE_DUPLICATE"]},
    {"id":"nbsp-trim", "document":"FDR", "other":{"bank":"\u00a0Fictional Bank\u00a0"}, "expected":["POSSIBLE_DUPLICATE"]},
    {"id":"casefold", "document":"FDR", "bank":"Straße Bank", "other":{"bank":"STRASSE BANK"}, "expected":["POSSIBLE_DUPLICATE"]},
    {"id":"internal-space-distinct", "document":"FDR", "other":{"bank":"Fictional  Bank"}, "expected":[]},
    {"id":"punctuation-distinct", "document":"FDR", "other":{"reference":"FDR001"}, "expected":[]},
    {"id":"release-plus-duplicate", "document":"RELEASE_EVIDENCE", "other":{}, "expected":["FDR_DOCUMENT_REQUIRED","POSSIBLE_DUPLICATE"]},
    {"id":"missing-other-institution", "document":"none", "other":{"institution":"other"}, "expected":["FDR_DOCUMENT_REQUIRED"]},
    {"id":"private-draft-duplicate", "document":"FDR", "other":{"status":"DRAFT"}, "expected":["POSSIBLE_DUPLICATE"]},
    {"id":"submitted-duplicate", "document":"FDR", "other":{"status":"SUBMITTED"}, "expected":["POSSIBLE_DUPLICATE"]},
    {"id":"correction-duplicate", "document":"FDR", "other":{"status":"CHANGES_REQUESTED"}, "expected":["POSSIBLE_DUPLICATE"]},
    {"id":"declared-no-text-check", "document":"FDR", "expected":[], "note":"PDF content is outside the two technical rules; no automated amount comparison is claimed."}
  ],
  "uploads": [
    {"id":"generated-pdf", "source":"sample-fdr.pdf", "name":"sample.pdf", "mime":"application/pdf", "expected_envelope_accept":true, "readable_by_construction":true},
    {"id":"generic-mime", "source":"sample-fdr.pdf", "name":"sample.pdf", "mime":"application/octet-stream", "expected_envelope_accept":true, "readable_by_construction":true},
    {"id":"uppercase-extension", "source":"sample-fdr.pdf", "name":"sample.PDF", "mime":"application/pdf", "expected_envelope_accept":true, "readable_by_construction":true},
    {"id":"wrong-extension", "source":"sample-fdr.pdf", "name":"sample.txt", "mime":"application/pdf", "expected_envelope_accept":false, "readable_by_construction":true},
    {"id":"wrong-mime", "source":"sample-fdr.pdf", "name":"sample.pdf", "mime":"text/html", "expected_envelope_accept":false, "readable_by_construction":true},
    {"id":"empty", "text":"", "name":"empty.pdf", "mime":"application/pdf", "expected_envelope_accept":false, "readable_by_construction":false},
    {"id":"not-pdf", "text":"This is plain text.", "name":"fake.pdf", "mime":"application/pdf", "expected_envelope_accept":false, "readable_by_construction":false},
    {"id":"truncated", "text":"%PDF-1.4\ntruncated", "name":"truncated.pdf", "mime":"application/pdf", "expected_envelope_accept":false, "readable_by_construction":false},
    {"id":"oversize", "source":"sample-fdr.pdf", "name":"large.pdf", "mime":"application/pdf", "limit":20, "expected_envelope_accept":false, "readable_by_construction":true},
    {"id":"unreadable-envelope", "text":"%PDF-1.7\nnot a PDF body\n%%EOF", "name":"unreadable.pdf", "mime":"application/pdf", "expected_envelope_accept":true, "readable_by_construction":false}
  ]
}
